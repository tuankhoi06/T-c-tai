PORT=4000

# Chế độ AI: "mock" (không tốn phí/offline) hoặc "live" (gọi AI thực tế)
AI_MODE=mock

# Chọn 1 trong 2 nhà cung cấp khi dùng AI_MODE=live:
# 1) Google Gemini (Khuyên dùng):
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# 2) OpenAI (Tùy chọn):
OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Để trống trong môi trường demo local.
# Nếu chạy web, có thể điền danh sách origin phân cách bằng dấu phẩy.
CORS_ORIGINS=
